FROM --platform=linux/arm64 ubuntu:24.04

RUN apt-get update && apt-get install -y \
    python3 python3-pip python3-dev \
    gcc g++ make \
    git curl wget \
    upx \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --break-system-packages pyinstaller

WORKDIR /build
COPY install2.py .

RUN pyinstaller \
    --onefile \
    --name install2-arm64 \
    --hidden-import=telegram \
    --hidden-import=telegram.ext \
    --hidden-import=telegram.ext.filters \
    --hidden-import=telegram.ext._application \
    --hidden-import=telegram.ext._commandhandler \
    --hidden-import=telegram.ext._callbackqueryhandler \
    --hidden-import=telegram.ext._messagehandler \
    --hidden-import=telegram._update \
    --hidden-import=telegram._inlinekeyboardbutton \
    --hidden-import=telegram._inlinekeyboardmarkup \
    --exclude-module=test \
    --exclude-module=unittest \
    --exclude-module=pytest \
    --exclude-module=doctest \
    --strip \
    install2.py

CMD ["cp", "dist/install2-arm64", "/output/install2-arm64.bin"]
